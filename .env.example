WANDB_PROJECT=sft-grpo-ablation
WANDB_ENTITY=your-username
HF_TOKEN=hf_xxx
# python-dotenv expands ${USER} but NOT $USER, so keep the braces or use an
# absolute path. Point these at a disk with room for the model + dataset cache.
HF_HOME=/scratch/${USER}/hf_cache
TRANSFORMERS_CACHE=/scratch/${USER}/hf_cache
